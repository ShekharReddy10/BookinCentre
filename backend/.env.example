# Local dev default: SQLite. For Supabase Postgres use:
# postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=sqlite:///./bcc.db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# --- Notifications (all optional — everything no-ops safely if left blank) ---

# Telegram: message @BotFather on Telegram -> /newbot -> copy the token.
# TELEGRAM_CHAT_ID is your own user id or a group's id (message @userinfobot to find yours).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (https://resend.com, free tier) - sign up, verify a sending domain, create an API key.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BCC <onboarding@resend.dev>

# Or, if you'd rather use an existing mailbox instead of Resend, fill these in (used only if RESEND_API_KEY is blank):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Who receives reminder/summary emails (comma-separated). Leave blank to default to all admin accounts.
NOTIFICATION_EMAIL_TO=

# Shared secret required in the X-Automation-Secret header to call /automation/* endpoints
# (e.g. from a GitHub Actions cron job). Generate any long random string.
AUTOMATION_SECRET=
